OPENAI_API_KEY=your_key_here
TITAN_LOG_LEVEL=INFO
TITAN_DEBUG_BRAIN=false
TITAN_LLM_MODEL=gpt-5.2
TITAN_MAX_PROMPT_TOKENS=12000
TITAN_PROMPTS_DIR=prompts
# Phase 9 — Autonomy (defaults: proactive off, confirmations on)
TITAN_AUTONOMY_PROACTIVE=off
TITAN_AUTONOMY_AUTO_TOOLS=false
TITAN_AUTONOMY_CONFIRM_WRITES=true
TITAN_AUTONOMY_CONFIRM_EXEC=true
TITAN_AUTONOMY_MAX_JOBS=10
TITAN_LLM_MODEL_CLASSIFICATION=gpt-5.2
TITAN_LLM_MODEL_AGENT=gpt-5.2
TITAN_LLM_MODEL_EVALUATION=gpt-5.2
# Phase 10A — Tool Runtime V2 (default on; set false for legacy Phase 6 path)
TITAN_TOOL_RUNTIME_V2=true
TITAN_TOOL_RUNTIME_VERSION=0.10.0
TITAN_TOOL_DEFAULT_EXECUTION_MODE=live
TITAN_TOOL_AUDIT_ENABLED=true
TITAN_TOOL_PERSIST_RUNS=false
TITAN_TOOL_PERSIST_METRICS=false
TITAN_TOOL_QUOTA_ENABLED=false
TITAN_TOOL_CONFIRMATION_TTL=300
# Phase 10B — Provider credentials (read only by CredentialManager; never commit real values)
TITAN_BRAVE_SEARCH_API_KEY=
TITAN_WEB_SEARCH_API_KEY=
TITAN_CALENDAR_CLIENT_ID=
TITAN_CALENDAR_CLIENT_SECRET=
# Phase 10B — Provider configuration (non-secret)
TITAN_WEB_SEARCH_ENABLED=true
TITAN_BRAVE_SEARCH_ENABLED=true
TITAN_CALENDAR_ENABLED=true
TITAN_CALENDAR_PROVIDER=mock
# Phase 14.2 — Google Calendar backend (OAuth local)
TITAN_GOOGLE_CALENDAR_ENABLED=false
TITAN_GOOGLE_CLIENT_SECRET_PATH=data/google_client_secret.json
TITAN_GOOGLE_TOKEN_PATH=data/google_calendar_token.json
# Phase 15.2 — Gmail backend (OAuth local)
TITAN_EMAIL_ENABLED=true
TITAN_EMAIL_PROVIDER=mock
TITAN_GMAIL_ENABLED=false
TITAN_GMAIL_CLIENT_SECRET_PATH=data/google_gmail_client_secret.json
TITAN_GMAIL_TOKEN_PATH=data/google_gmail_token.json
# Phase 12.5 — Obsidian connector (existing user vault only; not Titan memory/brain)
# Point TITAN_OBSIDIAN_VAULT_PATH at your existing Obsidian vault folder (e.g. "Titan AI").
# Titan never creates a new vault — it only reads and maintains notes inside this path.
TITAN_OBSIDIAN_ENABLED=false
TITAN_OBSIDIAN_VAULT_PATH=
# Phase 13.2 — Browser connector (Playwright backend; read-only inspection)
TITAN_BROWSER_ENABLED=false
TITAN_BROWSER_TIMEOUT_SECONDS=30
TITAN_BROWSER_HEADLESS=true
# Core Browser Tool V1 — HTTP read-only (core/tools/browser)
TITAN_BROWSER_MAX_DOWNLOAD_SIZE=5242880
TITAN_BROWSER_USER_AGENT=TitanBot/1.0 (Read-Only Browser Tool)
TITAN_BROWSER_FOLLOW_REDIRECTS=true
TITAN_BROWSER_ALLOWED_SCHEMES=http,https
TITAN_EXECUTION_MAX_AGENTS=3
TITAN_EXECUTION_MAX_TOOLS=3
# Phase 18.4 — Execution recovery / retry / rollback
TITAN_EXECUTION_RETRY_MAX_ATTEMPTS=3
TITAN_EXECUTION_RETRY_DELAY=0.05
TITAN_EXECUTION_RETRY_BACKOFF_MULTIPLIER=2.0
TITAN_EXECUTION_RETRY_ON_TIMEOUT=true
# Optional wall-clock timeout for bridge dispatch (empty = no default timeout)
TITAN_EXECUTION_TIMEOUT_SECONDS=
TITAN_EXECUTION_CHECKPOINT_PATH=data/execution_checkpoint.json
# Python Runtime V1 — sandboxed execution (core/tools/python)
TITAN_TOOL_PYTHON_TIMEOUT=5
TITAN_PYTHON_RUNTIME_TIMEOUT_SECONDS=5
TITAN_PYTHON_RUNTIME_MAX_EXECUTION_SECONDS=5
TITAN_PYTHON_RUNTIME_MAX_OUTPUT_BYTES=65536
TITAN_PYTHON_RUNTIME_MAX_FILE_COUNT=50
# Optional isolated workspace (defaults to system temp /titan_python_runtime)
TITAN_PYTHON_RUNTIME_WORKSPACE=
# Terminal Tool V1 — controlled workspace shell (core/tools/terminal)
# Defaults to PROJECT_ROOT. Dangerous commands are blocked; execution requires confirmation.
TITAN_TERMINAL_TIMEOUT_SECONDS=30
TITAN_TERMINAL_MAX_EXECUTION_SECONDS=120
TITAN_TERMINAL_MAX_OUTPUT_BYTES=65536
TITAN_TERMINAL_WORKSPACE=
# Optional comma-separated allowlist override (defaults: git,pytest,python,npm,uv,...)
TITAN_TERMINAL_ALLOWED_COMMANDS=
# Optional comma-separated blocked substring patterns
TITAN_TERMINAL_BLOCKED_PATTERNS=
# GitHub Tool V1 — read-only repository access (core/tools/github)
# Personal Access Token only — never commit real tokens.
TITAN_GITHUB_TOKEN=
TITAN_GITHUB_ENABLED=true
TITAN_GITHUB_TIMEOUT_SECONDS=30
TITAN_GITHUB_RETRY_COUNT=2
TITAN_GITHUB_PER_PAGE=30
TITAN_GITHUB_API_BASE_URL=https://api.github.com
TITAN_GITHUB_USER_AGENT=TitanBot/1.0 (Read-Only GitHub Tool)
# Phase 16.5 — Apex/Rithmic read-only broker adapter (credential validation only; no live SDK)
TITAN_BROKER_PROVIDER=apex_rithmic
TITAN_BROKER_READ_ONLY=true
TITAN_TRADING_LIVE_ENABLED=false
TITAN_RITHMIC_ENABLED=false
TITAN_RITHMIC_USERNAME=
TITAN_RITHMIC_PASSWORD=
TITAN_RITHMIC_SYSTEM=
TITAN_RITHMIC_SERVER=
TITAN_RITHMIC_APP_NAME=Titan
TITAN_RITHMIC_APP_VERSION=1.0
# Phase 17.1 — Private web app (local only; disabled by default)
# Set TITAN_WEB_ENABLED=true to start with `python main.py web`.
# Or use `python main.py web-dev` for local development without changing .env.
# Or use `python main.py web-remote` for Cloudflare Tunnel access (see docs/REMOTE_ACCESS.md).
TITAN_WEB_ENABLED=false
TITAN_WEB_HOST=127.0.0.1
TITAN_WEB_PORT=8000
TITAN_WEB_REMOTE_PORT=8765
TITAN_WEB_SECRET_KEY=

# Phase 10 — Cloud deployment (Railway is the fixed production provider)
# Local: development. Railway: set TITAN_APP_ENV=production (see docs/RAILWAY_DEPLOYMENT.md).
# Use TITAN_APP_ENV=production with `python main.py web-prod` or container CMD.
TITAN_APP_ENV=development
# Railway injects PORT; Titan also reads TITAN_WEB_PORT. Do not hardcode on Railway.
PORT=
TITAN_PUBLIC_BASE_URL=
TITAN_ALLOWED_HOSTS=
TITAN_CORS_ALLOWED_ORIGINS=
TITAN_AUTH_REQUIRED=
TITAN_COOKIE_SECURE=false
TITAN_DATA_DIR=data
# Phase 13.1 — Live working state (JSON; not long-term memory / not chat history)
TITAN_STATE_PATH=
# Phase 14.1 — Current execution missions (JSON; not long-term memory / not chat history)
TITAN_MISSION_PATH=
# Phase 15.1 — Multi-mission projects (JSON; ProjectManager owns truth)
TITAN_PROJECT_PATH=
# Phase 16.1 — Multi-project goals (JSON; GoalManager owns truth)
TITAN_GOAL_PATH=
# Phase 17.4 — Decision feedback / learning history (JSON; DecisionEngine owns)
TITAN_DECISION_HISTORY_PATH=
TITAN_MEMORY_DIR=
TITAN_DATABASE_URL=
# Phase 12.1 — Durable web conversations (Postgres on Railway via DATABASE_URL;
# local/dev falls back to SQLite at data/conversations.db when URL is empty).
# Alias: DATABASE_URL (Railway Postgres plugin).
TITAN_CONVERSATION_PERSISTENCE_ENABLED=true
# Required in production/staging by default — /ready fails if DB unreachable.
TITAN_CONVERSATION_PERSISTENCE_REQUIRED=
TITAN_CONVERSATION_CONTEXT_MAX_TOKENS=3000
# Phase 12.2 — When history exceeds this many usable turns, older turns
# collapse into a durable conversation summary (Postgres metadata), not discard.
TITAN_CONVERSATION_SUMMARY_THRESHOLD=16
TITAN_CONVERSATION_SUMMARY_MAX_CHARS=1200
TITAN_CONVERSATION_STREAM_ENABLED=true
# Phase 11.x / 19.6 — Brain lock / chat deadline budgets (seconds unless noted)
# Lock wait must stay comfortably below TITAN_CHAT_DEADLINE_SECONDS.
# Stale threshold must exceed lock wait; heartbeat must be much smaller than stale.
TITAN_CHAT_DEADLINE_SECONDS=30
TITAN_BRAIN_LOCK_TIMEOUT_SECONDS=5
TITAN_BRAIN_LOCK_STALE_SECONDS=45
TITAN_BRAIN_LOCK_HEARTBEAT_SECONDS=2
TITAN_BRAIN_LOCK_RECLAIM_ENABLED=true
TITAN_DB_CONNECT_TIMEOUT_SECONDS=5
TITAN_DB_STATEMENT_TIMEOUT_MS=15000
TITAN_CHAT_DIAGNOSTICS=true
TITAN_LOG_LEVEL=INFO
# Phase 10.3 — Private production authentication (session cookies)
# NEVER put a plaintext password in this file or in Git.
# Generate a hash locally: python scripts/generate_titan_password_hash.py
# Then set these in Railway Variables only:
#   AUTH_REQUIRED=true
#   TITAN_AUTH_USERNAME=
#   TITAN_AUTH_PASSWORD_HASH=
#   TITAN_SESSION_IDLE_MINUTES=60
#   TITAN_SESSION_MAX_HOURS=24
# Optional second authorized user (e.g. Ibrahim) without rewrite:
#   TITAN_AUTH_USERNAME_2=
#   TITAN_AUTH_PASSWORD_HASH_2=
TITAN_AUTH_USERNAME=
TITAN_AUTH_PASSWORD_HASH=
TITAN_AUTH_USERNAME_2=
TITAN_AUTH_PASSWORD_HASH_2=
TITAN_SESSION_IDLE_MINUTES=60
TITAN_SESSION_MAX_HOURS=24
# Phase 19.5 — Authenticated Railway soak credentials (local only; NEVER commit values)
# Used by: python scripts/phase19_5_railway_soak.py
TITAN_SOAK_USERNAME=
TITAN_SOAK_PASSWORD=
# TITAN_SOAK_BASE_URL=https://titan-production-e377.up.railway.app
# Aliases accepted: APP_ENV, HOST, SESSION_SECRET, PUBLIC_BASE_URL, ALLOWED_HOSTS,
# CORS_ALLOWED_ORIGINS, AUTH_REQUIRED, COOKIE_SECURE, DATABASE_URL, OBSIDIAN_VAULT_PATH,
# BROWSER_TOOL_ENABLED, VOICE_RUNTIME_ENABLED, TRADING_RUNTIME_ENABLED, LOG_LEVEL
# Railway template examples (set in Railway Variables UI, not in this file):
#   TITAN_PUBLIC_BASE_URL=https://${{RAILWAY_PUBLIC_DOMAIN}}
#   TITAN_ALLOWED_HOSTS=${{RAILWAY_PUBLIC_DOMAIN}},healthcheck.railway.app
#   TITAN_CORS_ALLOWED_ORIGINS=https://${{RAILWAY_PUBLIC_DOMAIN}}

# Phase 17.8 — Voice interface (browser STT/TTS + Voice Runtime V1)
TITAN_VOICE_ENABLED=true
TITAN_VOICE_LOCALE=fr-FR
TITAN_VOICE_CONTINUOUS=false
TITAN_VOICE_TTS_RATE=0.95
TITAN_VOICE_TTS_PITCH=1.0
TITAN_VOICE_VOLUME=1.0
TITAN_VOICE_VOICE=default
TITAN_VOICE_STT_PROVIDER=mock
TITAN_VOICE_TTS_PROVIDER=mock
TITAN_VOICE_MICROPHONE=default
TITAN_VOICE_SPEAKER=default
TITAN_VOICE_SILENCE_TIMEOUT=2.0
TITAN_VOICE_CONVERSATION_MODE=single_shot
TITAN_VOICE_SESSIONS_PATH=data/voice_sessions.json
# Phase 20.1 — speaker identification + OpenAI voice providers
TITAN_VOICE_SPEAKER_ID_ENABLED=true
TITAN_VOICE_SPEAKER_MIN_CONFIDENCE=0.72
TITAN_VOICE_SPEAKER_PROFILES_PATH=data/voice_speaker_profiles.json
TITAN_VOICE_OPENAI_STT_MODEL=whisper-1
TITAN_VOICE_OPENAI_TTS_MODEL=gpt-4o-mini-tts
# Phase 20.2 — guided voice enrollment
TITAN_VOICE_ENROLLMENT_MIN_SAMPLES=3
TITAN_VOICE_ENROLLMENT_MAX_SAMPLES=8
TITAN_VOICE_ENROLLMENT_MIN_DURATION=1.0
TITAN_VOICE_ENROLLMENT_MAX_DURATION=30.0
TITAN_VOICE_ENROLLMENT_MIN_QUALITY=0.45
TITAN_VOICE_ENROLLMENT_MIN_CONFIDENCE=0.72
TITAN_VOICE_SPEAKER_MEDIUM_CONFIDENCE=0.55
TITAN_VOICE_SPEAKER_AMBIGUITY_DELTA=0.05
TITAN_VOICE_ENROLLMENT_MAX_VERIFY_RETRIES=3
TITAN_VOICE_ENROLLMENT_TEMP_DIR=data/voice_enrollment_tmp
# Phase 20.3 — live voice session orchestration
TITAN_VOICE_VAD_SPEECH_START=0.035
TITAN_VOICE_VAD_SPEECH_END=0.018
TITAN_VOICE_VAD_SILENCE_TIMEOUT=1.2
TITAN_VOICE_VAD_MIN_UTTERANCE=0.35
TITAN_VOICE_VAD_MAX_UTTERANCE=30.0
TITAN_VOICE_VAD_NOISE_TOLERANCE=0.012
TITAN_VOICE_VAD_SENSITIVITY=0.55
TITAN_VOICE_TTS_STRATEGY=sentence_buffered
TITAN_VOICE_TTS_MIN_CHUNK_CHARS=24
TITAN_VOICE_TTS_VOICE_FR=alloy
TITAN_VOICE_TTS_VOICE_EN=verse
TITAN_VOICE_IDENTITY_CONFIRM_TIMEOUT=45.0
TITAN_VOICE_PROVIDER_TIMEOUT=60.0
TITAN_VOICE_LIVE_TEMP_DIR=data/voice_live_tmp
TITAN_VOICE_ALWAYS_LISTENING=false
TITAN_VOICE_WAKE_WORD_ENABLED=false
# Phase 20.5 — real-time conversation engine
TITAN_VOICE_IDLE_TIMEOUT=90.0
TITAN_VOICE_CONVERSATION_TIMEOUT=1800.0
TITAN_VOICE_RECOVERY_TTL=600.0
TITAN_VOICE_STREAMING_STT=true
TITAN_VOICE_STREAMING_TTS=true
# Phase 20.6 — provider-level realtime streaming (off by default; mock-safe)
TITAN_VOICE_REALTIME_STREAMING=false
TITAN_VOICE_REALTIME_STT_PROVIDER=mock_realtime_stt
TITAN_VOICE_REALTIME_TTS_PROVIDER=mock_realtime_tts
TITAN_VOICE_REALTIME_STT_FALLBACK=openai_whisper_streaming,deepgram_streaming,mock_realtime_stt
TITAN_VOICE_REALTIME_TTS_FALLBACK=elevenlabs_streaming,mock_realtime_tts
TITAN_VOICE_TRANSPORT=websocket
TITAN_VOICE_TRANSPORT_HEARTBEAT=15.0
TITAN_VOICE_TRANSPORT_RECONNECT_MAX=5
TITAN_VOICE_PROVIDER_RETRY_MAX=3
TITAN_VOICE_DEEPGRAM_MODEL=nova-2
TITAN_VOICE_ELEVENLABS_VOICE=Rachel
TITAN_VOICE_ELEVENLABS_MODEL=eleven_multilingual_v2
TITAN_VOICE_OPENAI_REALTIME_MODEL=gpt-4o-realtime-preview
TITAN_VOICE_AUDIO_COALESCE_BYTES=3200
TITAN_VOICE_TTS_BUFFER_MS=80.0
# Phase 20.7 — live experience polish (mic calibration / silence / turn timing)
TITAN_VOICE_MIC_CALIBRATION_SECONDS=1.25
TITAN_VOICE_MIC_LOW_VOLUME_RMS=0.025
TITAN_VOICE_MIC_CLIPPING_RATIO=0.02
TITAN_VOICE_MIC_TARGET_RMS=0.18
TITAN_VOICE_LONG_PAUSE_TIMEOUT=8.0
TITAN_VOICE_FALSE_SPEECH_MAX=0.22
TITAN_VOICE_NATURAL_PAUSE_MS=280.0
TITAN_VOICE_MIN_TURN_GAP_MS=180.0
TITAN_VOICE_BARGE_IN_DEBOUNCE_MS=120.0
TITAN_VOICE_RESUME_GRACE_MS=200.0
# Phase 20.8 — live providers + browser WebSocket + enrollment prep
TITAN_VOICE_LIVE_SOCKETS=true
TITAN_VOICE_WS_ENABLED=true
TITAN_VOICE_WS_HEARTBEAT=12.0
TITAN_VOICE_WS_HEARTBEAT_TIMEOUT=40.0
TITAN_VOICE_WS_BACKPRESSURE_MAX_QUEUE=64
TITAN_VOICE_WS_BACKPRESSURE_MAX_BYTES=512000
TITAN_VOICE_WS_MAX_CONNECTIONS=32
TITAN_VOICE_ENROLLMENT_DUPLICATE_THRESHOLD=0.92
TITAN_VOICE_EMBEDDING_VERSION=histogram_v1
# Phase 20.9 / 20.10A / 20.10B-1 — enrollment readiness + production activation
# Dev/test default remains histogram. For production enrollment activation set:
#   TITAN_VOICE_EMBEDDING_PROVIDER=ecapa
#   TITAN_VOICE_BIOMETRIC_TRUST_MODE=production
#   TITAN_VOICE_EMBEDDING_ENCRYPTION=true
#   TITAN_VOICE_EMBEDDING_STORAGE_KEY=<generate locally; never commit>
TITAN_VOICE_EMBEDDING_PROVIDER=histogram
TITAN_VOICE_ENROLLMENT_REQUIRE_CONSENT=true
TITAN_VOICE_ENROLLMENT_CONSENT_VERSION=v1
TITAN_VOICE_ENROLLMENT_RECOVERY_TTL=3600
TITAN_VOICE_ENROLLMENT_SAME_USER_DUP_THRESHOLD=0.97
# Phase 20.11 — production speaker embeddings & identity security
# histogram remains the default DEV fallback — never silently production-trusted.
# Production-path drills: TITAN_VOICE_EMBEDDING_PROVIDER=local_deterministic
TITAN_VOICE_EMBEDDING_REQUIRE_PRODUCTION_TRUST=false
TITAN_VOICE_EMBEDDING_ALLOW_DEV_IDENTITY=true
TITAN_VOICE_EMBEDDING_ENCRYPTION=false
TITAN_VOICE_EMBEDDING_RETAIN_RAW_AUDIO=false
TITAN_VOICE_ANTI_SPOOF_PROVIDER=null
TITAN_VOICE_EMBEDDING_AGGREGATION=max_centroid
# Optional secret (NEVER put a real key here / NEVER commit real values):
# TITAN_VOICE_EMBEDDING_STORAGE_KEY=
# Generate locally: python scripts/ensure_voice_embedding_storage_key.py
# Activate production host flags: python scripts/activate_production_enrollment_env.py
# Phase 20.12 — real speaker biometric backend
# Trust mode: development | production (empty = derive from TITAN_APP_ENV)
# TITAN_VOICE_BIOMETRIC_TRUST_MODE=development
# Real ECAPA (requires optional torch+speechbrain): TITAN_VOICE_EMBEDDING_PROVIDER=ecapa
# Resemblyzer fallback (requires optional resemblyzer): TITAN_VOICE_EMBEDDING_PROVIDER=resemblyzer
TITAN_VOICE_EMBEDDING_KEY_ID=primary
TITAN_VOICE_ECAPA_MODEL_DIR=data/voice_models/ecapa
TITAN_VOICE_ECAPA_DEVICE=cpu
TITAN_VOICE_ECAPA_INIT_TIMEOUT=120
# Phase 20.10B-1 / 20.13 — production enrollment activation
# Local: python scripts/activate_production_enrollment_env.py
# Railway image Dockerfile already sets the non-secret production flags below.
# TITAN_VOICE_EMBEDDING_PROVIDER=ecapa
# TITAN_VOICE_EMBEDDING_VERSION=ecapa_v1
# TITAN_VOICE_BIOMETRIC_TRUST_MODE=production
# TITAN_VOICE_EMBEDDING_REQUIRE_PRODUCTION_TRUST=true
# TITAN_VOICE_EMBEDDING_ALLOW_DEV_IDENTITY=false
# TITAN_VOICE_EMBEDDING_ENCRYPTION=true
# Storage key: generate locally (NEVER commit / NEVER paste into this file):
#   python scripts/ensure_voice_embedding_storage_key.py
# Then copy TITAN_VOICE_EMBEDDING_STORAGE_KEY from .env into Railway Variables.
# Preflight: python scripts/phase20_10b1_enrollment_preflight.py
# Guided entry: python scripts/phase20_10b1_guided_enroll.py --user Nolan
# Windows: leave empty (defaults to COPY — avoids symlink privilege errors).
# Optional override: copy | symlink | copy_skip_cache | no_link
# TITAN_VOICE_ECAPA_LOCAL_STRATEGY=
# Optional secrets for live streaming (never commit real values):
# DEEPGRAM_API_KEY=
# ELEVENLABS_API_KEY=
# Live providers (optional): set TITAN_VOICE_STT_PROVIDER=openai_whisper
# and TITAN_VOICE_TTS_PROVIDER=openai_tts when OPENAI_API_KEY is configured.
# Realtime STT can also use openai_realtime / deepgram_streaming when
# TITAN_VOICE_REALTIME_STREAMING=true and keys + websocket-client are present.
